# ---- Supabase (Settings → API in your Supabase project) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Admin login (server-only) ----
ADMIN_PASSWORD=choose_a_long_random_password
# Optional but recommended: a separate random string used to sign the login
# cookie. Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Email notifications for booking requests (optional, via resend.com) ----
# Leave blank to disable. When all three are set, the owner gets an email for
# every booking request and the customer gets a confirmation if they gave one.
RESEND_API_KEY=
NOTIFY_EMAIL=owner@example.com
EMAIL_FROM="D&K Car Rentals <bookings@yourdomain.com>"
# Public URL of the site, used for links in emails (e.g. https://dkcarrentals.vercel.app)
NEXT_PUBLIC_SITE_URL=

# ---- Business details shown on invoices (optional) ----
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
